# Obsidian local config — each user configures their own appearance,
# enabled plugins, and workspace. Vault content is what's shared.
.obsidian/

# Private notes / drafts not intended for the public repo
_Private/

# OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Editor noise
.vscode/
.idea/

# Local-only ephemera
_Local/
*.tmp

# Python build / cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Quartz site build artifacts. The Quartz source lives in `quartz/`
# (tracked); only the installed dependencies and built output are
# ignored here.
quartz/node_modules/
quartz/public/
quartz/.quartz-cache/
quartz/tsconfig.tsbuildinfo
quartz/prof/
